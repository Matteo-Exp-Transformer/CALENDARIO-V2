# Console super-admin — variabili d'ambiente
# Copia questo file in .env.local e inserisci i valori reali.
# .env.local è gitignored: NON committare mai chiavi reali.

# URL del progetto Supabase TEST (docnnernvp).
# Recupera da: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Chiave pubblica (anon/publishable) del progetto Supabase TEST.
# È sicura nel browser: RLS la protegge. La service role key NON va qui.
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Allowlist email per il gate di accesso alla Console (F3 — auth reale).
# Lista separata da virgole; il confronto è case-insensitive.
# Inserisci qui l'email Supabase di Matteo (quella con cui è registrato in Supabase Auth).
# Se questa variabile è assente o vuota, NESSUNA email sarà ammessa (fail-safe).
# Esempio: VITE_CONSOLE_ALLOWED_EMAILS=matteo@esempio.com
VITE_CONSOLE_ALLOWED_EMAILS=<email-di-matteo>
