# ============================================================
# VARIABILI D'AMBIENTE — Copia questo file in .env.local
# e sostituisci i valori con le credenziali reali
# ============================================================

# URL del tuo progetto Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chiave anonima (anon key) del tuo progetto Supabase
# La trovi su: Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key-here



# ============================================================
# VARIABILI E2E PLAYWRIGHT — Copia in .env.local.test
# ============================================================

# Admin Classic (tenant 22222222-...) — usato dalla maggior parte dei test E2E
E2E_ADMIN_EMAIL=admin-classic@test.local
E2E_ADMIN_PASSWORD=TestE2E2026!
E2E_CLASSIC_TENANT_ID=22222222-2222-2222-2222-222222222222

# Admin Pro (tenant 11111111-...) — usato dai test in e2e/pro/
# Se non impostato, i test Pro vengono saltati automaticamente
E2E_PRO_ADMIN_EMAIL=admin-pro@test.local
E2E_PRO_ADMIN_PASSWORD=TestE2E2026!
# Service role key dello staging (richiesta solo da edition-upgrade.spec.ts)
E2E_SUPABASE_SERVICE_KEY=your-staging-service-role-key