# ============================================================
# VARIABILI D'AMBIENTE — Copia questo file in .env.local
# e sostituisci i valori con le credenziali reali
# ============================================================

# URL del tuo progetto Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chiave anonima (anon key) del tuo progetto Supabase
# La trovi su: Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key-here



