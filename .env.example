# ============================================================
# VARIABILI D'AMBIENTE — Copia questo file in .env.local
# e sostituisci i valori con le credenziali reali
# ============================================================

# URL del tuo progetto Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chiave anonima (anon key) del tuo progetto Supabase
# La trovi su: Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Slug tenant (tabella organizations.slug), stesso della URL /prenota/<slug>
# Obbligatorio per: npm run seed:booking-menu-full
# TENANT_SLUG=il-tuo-slug

# Invio email dal browser (Edge Function send-email). Default: assente = disattivato.
# Evita errori in console se send-email non è deployata. Metti true solo con funzione attiva + segreti.
# VITE_ENABLE_SEND_EMAIL=true
